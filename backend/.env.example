# Copy to backend/.env and adjust if needed. backend/.env is gitignored -- never
# commit real values here. Every default below matches backend/docker-compose.yml
# and aventum_ingest/config.py exactly, so leaving this file uncopied and unset
# works out of the box for local development.

# Overrides docker-compose.yml's POSTGRES_PASSWORD. Only worth setting if you are
# running this compose file somewhere other than localhost -- the shipped default
# is a throwaway local-dev value, not a secret.
POSTGRES_PASSWORD=aventum_local_dev

# Consumed by aventum_ingest/config.py. Must stay in sync with POSTGRES_PASSWORD
# above if you change it.
AVENTUM_DATABASE_URL=postgresql+psycopg://aventum:aventum_local_dev@localhost:5433/aventum

# Optional: override the canonical source file path.
# AVENTUM_SOURCE_PATH=data/raw/UPI Transactions 2024 Dataset/upi_transactions_2024.csv
